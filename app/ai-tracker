#!/bin/sh
# AI Tracker: open or quit the top-bar widget, like an app.
#   ai-tracker          open it: turn it back on if it was quit, then open its menu
#   ai-tracker --quit   quit it: take it off the top bar (it stays off after logging in again)
# GNOME runs one copy of an extension, so opening it again never starts a second widget.
# Everything goes through GNOME Shell's own D-Bus interface for extensions.
set -u
UUID=${AI_TRACKER_UUID:-ai-tracker@danielmapar} # AI_TRACKER_UUID is for the tests

say() {
    printf 'AI Tracker: %s\n' "$1" >&2
    # Opened from Activities there is no terminal: say it in a notification too.
    [ -t 2 ] || notify-send --app-name="AI Tracker" --icon=io.github.danielmapar.AiTracker "AI Tracker" "$1" 2>/dev/null || true
}

shell_ext() { # METHOD [ARG]: GNOME Shell's extensions interface
    m=$1
    shift
    gdbus call --session --timeout 5 --dest org.gnome.Shell --object-path /org/gnome/Shell \
        --method "org.gnome.Shell.Extensions.$m" "$@" 2>/dev/null
}

# 1 running, 2 or 6 off, 3 error, 4 not for this GNOME version, 7/8 switching; empty: unknown here
state() {
    shell_ext GetExtensionInfo "$UUID" | sed -n "s/.*'state': <\([0-9]*\).*/\1/p"
}

open_menu() {
    gdbus call --session --timeout 5 --dest org.gnome.Shell --object-path /io/github/danielmapar/AiTracker \
        --method io.github.danielmapar.AiTracker.Open >/dev/null 2>&1
}

case "${1:-}" in
    "" | --open) ;;
    --quit)
        out=$(shell_ext DisableExtension "$UUID") || { say "GNOME Shell is not answering."; exit 1; }
        case "$out" in *true*) exit 0 ;; esac
        say "This GNOME session has not loaded AI Tracker, so there is nothing to quit."
        exit 1
        ;;
    -h | --help) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $1 (try --help)" >&2; exit 2 ;;
esac

info=$(shell_ext GetExtensionInfo "$UUID") || { say "GNOME Shell is not answering. Is this a GNOME session?"; exit 1; }
s=$(printf '%s' "$info" | sed -n "s/.*'state': <\([0-9]*\).*/\1/p")
case "$s" in
    1) ;;
    "")
        say "This GNOME session started before AI Tracker was installed. Log out and back in once, then open it again."
        exit 1
        ;;
    3) say "AI Tracker hit an error. The Extensions app shows it; running ./install.sh again usually fixes it."; exit 1 ;;
    4) say "AI Tracker does not support this GNOME Shell version."; exit 1 ;;
    *)
        case "$(gdbus call --session --timeout 5 --dest org.gnome.Shell --object-path /org/gnome/Shell \
            --method org.freedesktop.DBus.Properties.Get org.gnome.Shell.Extensions UserExtensionsEnabled 2>/dev/null)" in
            *false*) say "Extensions are turned off. Turn them on in the Extensions app, then open AI Tracker again."; exit 1 ;;
        esac
        shell_ext EnableExtension "$UUID" >/dev/null || { say "Could not turn AI Tracker on."; exit 1; }
        ;;
esac

# The widget appears a moment after it is turned on: keep asking for its menu for up to 5 s.
i=0
until open_menu; do
    i=$((i + 1))
    if [ "$i" -ge 50 ]; then
        case "$(state)" in
            1) say "AI Tracker is on, but its menu did not answer. Click its icon in the top bar." ;;
            3) say "AI Tracker hit an error while starting. The Extensions app shows it." ;;
            *) say "AI Tracker did not start." ;;
        esac
        exit 1
    fi
    sleep 0.1
done
